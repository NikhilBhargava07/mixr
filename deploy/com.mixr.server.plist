<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>              <string>com.mixr.server</string>
  <key>WorkingDirectory</key>   <string>/Users/nikhilbhargava/random_projects/mixr</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/nikhilbhargava/random_projects/mixr/.venv/bin/uvicorn</string>
    <string>app.server:app</string>
    <string>--port</string><string>8765</string>
    <string>--host</string><string>127.0.0.1</string>
  </array>
  <!-- start at login, and bring it back if it ever dies -->
  <key>RunAtLoad</key>          <true/>
  <key>KeepAlive</key>          <true/>
  <key>StandardOutPath</key>    <string>/tmp/mixr.log</string>
  <key>StandardErrorPath</key>  <string>/tmp/mixr.err</string>
</dict>
</plist>
